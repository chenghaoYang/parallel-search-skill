      "hosts": ["ai.google.dev"],
      "source": "https://ai.google.dev/api/generate-content",
      "quote": "contents[] Required. The content of the current conversation with the model. systemInstruction Optional."
    },
    {
      "id": "deepseek-openai-base",
      "claim": "DeepSeek 的 OpenAI 兼容 base URL 是 https://api.deepseek.com ，聊天路径是 /chat/completions。",
